# Copy to the git-ignored root .env for local development; process environment overrides it.
# Input uses private object storage only; MySQL is loaded only by explicit search/migration code.
# No database configuration or migration is needed for input.
ENVIRONMENT=development
MAX_SESSION_TASKS=100
# local is development-only; production requires private S3.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIRECTORY=./data/objects
# Production: ENVIRONMENT=production, STORAGE_BACKEND=s3
# Private bucket: deny anonymous access; never put credentials in frontend code.
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
MAX_FILE_BYTES=10000000
MAX_REQUEST_BYTES=11534336
PARSE_TIMEOUT_SECONDS=15
MAX_PROCESSING_TASKS=2
MAX_PDF_PAGES=30
MAX_PRIMARY_CHARACTERS=30000
MAX_SUPPLEMENT_CHARACTERS=2000
MAX_ZIP_BYTES=52428800
MAX_ZIP_ENTRIES=1000
MAX_ZIP_RATIO=100
SESSION_HOURS=24
SESSION_REQUESTS_PER_MINUTE=10
WRITE_REQUESTS_PER_MINUTE=10

# Paid extraction is development-only; blank key disables extraction, not input/edit/read.
# No automatic retries. Global cumulative reservations are never refunded/reset.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
EXTRACTION_TIMEOUT_SECONDS=90
EXTRACTION_MAX_OUTPUT_TOKENS=6000
EXTRACTION_MAX_INPUT_TOKENS=20000
EXTRACTION_MAX_CALLS=5
MAX_REQUIREMENT_REVISIONS=50
MAX_TASK_EXTRACTIONS=3

# Search-only MySQL. Existing input/requirements never load these settings.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=projectpilot_search
MYSQL_USER=root
MYSQL_PASSWORD=
# Remote/production requires MYSQL_SSL_CA pointing to a trusted CA file.
# Online Alembic operations additionally require PROJECTPILOT_ALLOW_MIGRATIONS=1.
# Do not enable online migrations until the target database is explicitly approved.
